<script>
  var menuBtn = document.getElementById('menuBtn');
  var logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', function () {
      if (window.AtlasData) { AtlasData.logout(); } else { window.location.href = 'index.html'; }
    });
  }
  var sidebar = document.getElementById('sidebar');
  if (menuBtn) {
    menuBtn.addEventListener('click', function () { sidebar.classList.toggle('open'); });
  }
  document.addEventListener('click', function (e) {
    if (sidebar.classList.contains('open') && !sidebar.contains(e.target) && e.target !== menuBtn && !menuBtn.contains(e.target)) {
      sidebar.classList.remove('open');
    }
  });
</script>

<script>
document.addEventListener('atlas-data-ready', function () {
  if (!window.AtlasData) return;

  var SUBJECTS = AtlasData.SUBJECTS;
  var BIMESTRES = AtlasData.BIMESTRES;

  function isDevSession() { return AtlasData.isDev(); }
  if (isDevSession()) document.body.classList.add('dev-mode-on');

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function formatDateBR(isoDate) {
    if (!isoDate) return '';
    var parts = isoDate.split('-');
    if (parts.length !== 3) return isoDate;
    return parts[2] + '/' + parts[1] + '/' + parts[0];
  }
  function isDueSoon(isoDate) {
    if (!isoDate) return false;
    var due = new Date(isoDate + 'T00:00:00');
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    var diffDays = Math.round((due - today) / 86400000);
    return diffDays >= 0 && diffDays <= 3;
  }
  function fillSelect(select, options, selected) {
    select.innerHTML = options.map(function (opt) {
      var sel = opt === selected ? ' selected' : '';
      return '<option value="' + escapeHtml(opt) + '"' + sel + '>' + escapeHtml(opt) + '</option>';
    }).join('');
  }

  var params = new URLSearchParams(window.location.search);
  var taskId = params.get('id') || null;
  var presetMateriaSlug = params.get('materia') || '';
  var presetBimestre = params.get('bimestre') || '';
  var wantsEdit = params.get('edit') === '1';

  var SUBJECT_BY_SLUG = {};
  SUBJECTS.forEach(function (name) { SUBJECT_BY_SLUG[AtlasData.slugify(name)] = name; });
  var presetMateriaName = SUBJECT_BY_SLUG[presetMateriaSlug] || null;

  var loadingState = document.getElementById('loadingState');
  var errorState = document.getElementById('errorState');
  var viewWrap = document.getElementById('viewWrap');
  var editWrap = document.getElementById('editWrap');
  var backLink = document.getElementById('backLink');
  var backLinkText = document.getElementById('backLinkText');

  function setBackTarget(materiaName) {
    if (materiaName) {
      backLink.href = 'materia.html?materia=' + encodeURIComponent(AtlasData.slugify(materiaName));
      backLinkText.textContent = 'Voltar para ' + materiaName;
    } else {
      backLink.href = 'tarefas.html';
      backLinkText.textContent = 'Voltar para Tarefas';
    }
  }

  var conteudoEditor = window.AtlasEditor
    ? AtlasEditor.create(document.getElementById('fConteudoEditor'), { placeholder: 'Escreva o conteúdo da tarefa aqui...', minHeight: '220px' })
    : null;
  var respostaEditor = window.AtlasEditor
    ? AtlasEditor.create(document.getElementById('fRespostaEditor'), { placeholder: 'Resposta esperada ou orientações de correção...', minHeight: '140px' })
    : null;

  var currentTask = null; // null = criando

  function renderView(task) {
    document.title = task.titulo + ' — Atlas';
    document.getElementById('viewTitle').textContent = task.titulo;
    setBackTarget(task.materia);

    var dueSoon = isDueSoon(task.dataEntrega);
    var badges =
      '<span class="meta-badge">' + escapeHtml(task.materia) + '</span>' +
      '<span class="meta-badge">' + escapeHtml(task.bimestre) + '</span>' +
      '<span class="meta-badge due' + (dueSoon ? ' due-soon' : '') + '">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>' +
        'Entrega em ' + escapeHtml(formatDateBR(task.dataEntrega)) +
      '</span>';
    document.getElementById('viewMetaBadges').innerHTML = badges;

    var conteudoEl = document.getElementById('viewConteudo');
    var conteudoHtml = task.enunciado && task.enunciado.trim()
      ? task.enunciado
      : '<p class="atlas-editor-empty">Nenhum conteúdo cadastrado para esta tarefa ainda.</p>';
    if (window.AtlasEditor) AtlasEditor.renderReadOnly(conteudoEl, conteudoHtml);
    else conteudoEl.innerHTML = conteudoHtml;

    var respostaSection = document.getElementById('viewRespostaSection');
    if (task.resposta && task.resposta.trim()) {
      respostaSection.style.display = 'block';
      var respostaEl = document.getElementById('viewResposta');
      if (window.AtlasEditor) AtlasEditor.renderReadOnly(respostaEl, task.resposta);
      else respostaEl.innerHTML = task.resposta;
    } else {
      respostaSection.style.display = 'none';
    }

    viewWrap.style.display = 'block';
    editWrap.style.display = 'none';
  }

  function renderEdit(task) {
    document.title = (task ? 'Editar tarefa' : 'Nova tarefa') + ' — Atlas';
    setBackTarget(task ? task.materia : presetMateriaName);

    document.getElementById('fTitulo').value = task ? task.titulo : '';
    document.getElementById('fData').value = task ? task.dataEntrega : '';
    fillSelect(document.getElementById('fMateria'), SUBJECTS, task ? task.materia : (presetMateriaName || SUBJECTS[0]));
    fillSelect(document.getElementById('fBimestre'), BIMESTRES, task ? task.bimestre : (presetBimestre || BIMESTRES[0]));
    if (conteudoEditor) conteudoEditor.setHTML(task ? task.enunciado : '');
    if (respostaEditor) respostaEditor.setHTML(task ? task.resposta : '');

    document.getElementById('deleteBtnEdit').style.display = task ? 'inline-flex' : 'none';

    viewWrap.style.display = 'none';
    editWrap.style.display = 'block';
    setTimeout(function () { document.getElementById('fTitulo').focus(); }, 60);
  }

  function goBackAfterCancel() {
    if (currentTask) { renderView(currentTask); }
    else { window.location.href = backLink.href; }
  }

  function deleteAndLeave(task) {
    if (!isDevSession()) return;
    if (!window.confirm('Tem certeza que deseja excluir esta tarefa? Esta ação não pode ser desfeita.')) return;
    var materiaSlug = AtlasData.slugify(task.materia);
    AtlasData.deleteTask(task.id);
    window.location.href = 'materia.html?materia=' + encodeURIComponent(materiaSlug);
  }

  document.getElementById('editBtn').addEventListener('click', function () {
    if (!isDevSession() || !currentTask) return;
    renderEdit(currentTask);
  });
  document.getElementById('deleteBtn').addEventListener('click', function () {
    if (currentTask) deleteAndLeave(currentTask);
  });
  document.getElementById('deleteBtnEdit').addEventListener('click', function () {
    if (currentTask) deleteAndLeave(currentTask);
  });
  document.getElementById('cancelBtn').addEventListener('click', goBackAfterCancel);

  document.getElementById('editWrap').addEventListener('submit', function (e) {
    e.preventDefault();
    if (!isDevSession()) return;

    var saved = AtlasData.saveTask({
      id: currentTask ? currentTask.id : null,
      titulo: document.getElementById('fTitulo').value.trim(),
      materia: document.getElementById('fMateria').value,
      bimestre: document.getElementById('fBimestre').value,
      dataEntrega: document.getElementById('fData').value,
      enunciado: conteudoEditor ? conteudoEditor.getHTML() : '',
      resposta: respostaEditor ? respostaEditor.getHTML() : ''
    });

    if (!saved) return;
    currentTask = saved;

    // Atualiza a URL para refletir o id (sem recarregar a página), útil
    // para o caso de ter acabado de criar uma tarefa nova.
    var url = new URL(window.location.href);
    url.searchParams.set('id', saved.id);
    url.searchParams.delete('materia');
    url.searchParams.delete('bimestre');
    url.searchParams.delete('edit');
    window.history.replaceState({}, '', url);

    renderView(saved);
  });

  /* ---------------------------------------------------------
     Inicialização
  --------------------------------------------------------- */
  function init() {
    if (taskId) {
      var task = AtlasData.getTasks().find(function (t) { return t.id === taskId; });
      loadingState.style.display = 'none';
      if (!task) { errorState.style.display = 'block'; return; }
      currentTask = task;
      if (wantsEdit && isDevSession()) renderEdit(task);
      else renderView(task);
      return;
    }

    // Sem id: só faz sentido em modo dev, criando uma tarefa nova.
    loadingState.style.display = 'none';
    if (!isDevSession()) {
      errorState.querySelector('a') && (errorState.innerHTML = 'Você precisa estar no modo desenvolvedor para criar uma tarefa. <a href="materias.html">Voltar para Matérias</a>');
      errorState.style.display = 'block';
      return;
    }
    currentTask = null;
    renderEdit(null);
  }

  init();

  AtlasData.onDataChange(function () {
    if (!taskId) return;
    var updated = AtlasData.getTasks().find(function (t) { return t.id === taskId; });
    if (updated && editWrap.style.display === 'none') {
      currentTask = updated;
      renderView(updated);
    }
  });

  AtlasData.injectDevBanner();
});
</script>

</body>
</html>
