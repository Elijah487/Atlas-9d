<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tarefa — Atlas</title>
<style>

  /* ============ RESET & TOKENS (idênticos às demais páginas) ============ */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0a0e14;
    --surface: #10151d;
    --surface-2: #161c26;
    --line: #232a36;

    --blue: #2563eb;
    --blue-bright: #4f8dff;
    --blue-dim: #1d3a6e;

    --ink: #eef1f6;
    --ink-dim: #97a1b0;
    --ink-faint: #5e6675;

    --green: #3fb96f;
    --orange: #e0a23a;

    --radius: 10px;
    --radius-sm: 7px;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Arial, sans-serif;
    line-height: 1.5;
    font-size: 15px;
  }

  a { color: inherit; text-decoration: none; }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  ul { list-style: none; }
  input, select { font-family: inherit; }

  ::selection { background: var(--blue); color: #fff; }
  :focus-visible { outline: 2px solid var(--blue-bright); outline-offset: 2px; }

  .fast { transition: background-color 0.15s, border-color 0.15s, color 0.15s; }

  /* ============ APP SHELL ============ */
  .app {
    display: grid;
    grid-template-columns: 232px 1fr;
    grid-template-rows: 60px 1fr;
    grid-template-areas:
      "header header"
      "sidebar main";
    min-height: 100vh;
  }

  header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 20px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .brand-mark {
    width: 26px; height: 26px;
    border-radius: 7px;
    background: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    color: #fff;
    flex-shrink: 0;
  }
  .brand-word { font-size: 16px; font-weight: 600; }

  .search-wrap {
    flex: 1;
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
  }
  .search-wrap svg { width: 16px; height: 16px; color: var(--ink-faint); flex-shrink: 0; }
  .search-wrap input {
    flex: 1; background: none; border: none; color: var(--ink); font-size: 14px; outline: none;
  }
  .search-wrap input::placeholder { color: var(--ink-faint); }

  .header-right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .class-badge {
    display: flex; align-items: center; gap: 7px;
    padding: 7px 12px; border-radius: var(--radius-sm);
    background: var(--surface-2); border: 1px solid var(--line);
    font-size: 13px; color: var(--ink-dim);
  }
  .class-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }

  .logout-btn {
    display: flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: var(--radius-sm);
    background: var(--surface-2); border: 1px solid var(--line);
    color: var(--ink-dim); font-size: 13px; font-weight: 600;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .logout-btn:hover { background: #2a1414; border-color: #5c2222; color: #ff9a9a; }
  .logout-btn svg { width: 15px; height: 15px; flex-shrink: 0; }
  @media (max-width: 460px) { .logout-btn span { display: none; } }

  .sidebar {
    grid-area: sidebar;
    background: var(--surface);
    border-right: 1px solid var(--line);
    padding: 18px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-item {
    display: flex; align-items: center; gap: 11px;
    padding: 10px 12px; border-radius: var(--radius-sm);
    font-size: 14px; color: var(--ink-dim);
  }
  .nav-item svg { width: 18px; height: 18px; flex-shrink: 0; }
  .nav-item:hover { background: var(--surface-2); color: var(--ink); }
  .nav-item.active { background: var(--blue-dim); color: var(--blue-bright); font-weight: 600; }
  .sidebar-divider { height: 1px; background: var(--line); margin: 14px 4px; }

  .menu-btn {
    display: none; width: 36px; height: 36px; border-radius: var(--radius-sm);
    border: 1px solid var(--line); background: var(--surface-2);
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .menu-btn svg { width: 17px; height: 17px; }

  /* ============ MAIN — leitura estilo Notion/GitBook ============ */
  main {
    grid-area: main;
    padding: 32px 24px 80px;
    overflow-x: hidden;
  }

  .page-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-dim);
    padding: 7px 4px;
    margin-bottom: 22px;
  }
  .back-link:hover { color: var(--blue-bright); }
  .back-link svg { width: 15px; height: 15px; flex-shrink: 0; }

  .loading-state, .error-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--ink-faint);
    font-size: 14px;
  }
  .error-state a { color: var(--blue-bright); font-weight: 600; }

  /* ----- View mode ----- */
  .view-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 6px;
  }
  .view-title {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .view-actions { display: none; gap: 6px; flex-shrink: 0; padding-top: 4px; }
  body.dev-mode-on .view-actions { display: flex; }
  .icon-btn {
    width: 32px; height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-dim);
    display: flex; align-items: center; justify-content: center;
  }
  .icon-btn:hover { color: var(--blue-bright); border-color: var(--blue-dim); }
  .icon-btn.danger:hover { color: #ff7a7a; border-color: #5c2222; }
  .icon-btn svg { width: 15px; height: 15px; }

  .meta-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 28px;
  }
  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 100px;
    background: var(--blue-dim);
    color: var(--blue-bright);
  }
  .meta-badge svg { width: 12px; height: 12px; }
  .meta-badge.due { background: var(--surface-2); color: var(--ink-dim); border: 1px solid var(--line); }
  .meta-badge.due.due-soon { background: rgba(217,124,43,0.15); color: var(--orange); }

  .content-divider { height: 1px; background: var(--line); margin: 0 0 26px; }

  .content-section { margin-bottom: 34px; }
  .content-section-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    margin-bottom: 14px;
  }

  /* ----- Edit mode (form em página inteira) ----- */
  .field-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 7px;
    margin-top: 22px;
  }
  .field-label:first-of-type { margin-top: 0; }
  .field-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--ink);
    font-size: 15px;
    font-family: inherit;
  }
  .field-input:focus { outline: none; border-color: var(--blue-dim); }
  .field-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  @media (max-width: 720px) { .field-row { grid-template-columns: 1fr; } }

  .title-input {
    font-size: 26px;
    font-weight: 800;
    padding: 6px 0;
    border: none;
    border-bottom: 2px solid var(--line);
    border-radius: 0;
    background: transparent;
  }
  .title-input:focus { border-color: var(--blue-bright); }
  .title-input::placeholder { color: var(--ink-faint); font-weight: 700; }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .form-actions-left { display: flex; gap: 10px; }
  .btn-secondary, .btn-primary, .btn-danger-ghost {
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    border: 1px solid transparent;
  }
  .btn-secondary { background: var(--surface-2); color: var(--ink-dim); border-color: var(--line); }
  .btn-secondary:hover { color: var(--ink); }
  .btn-primary { background: var(--blue); color: #fff; }
  .btn-primary:hover { background: var(--blue-bright); }
  .btn-danger-ghost { background: none; color: #ff8a8a; border-color: #5c2222; }
  .btn-danger-ghost:hover { background: #2a1414; }

  /* ============ EDITOR RICO (Atlas Editor) ============ */
  .atlas-editor {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    overflow: hidden;
  }
  .atlas-editor-toolbar {
    display: flex; align-items: center; gap: 2px; flex-wrap: wrap;
    padding: 7px 8px; border-bottom: 1px solid var(--line); background: var(--surface);
  }
  .atlas-editor-btn {
    min-width: 30px; height: 30px; padding: 0 8px; border-radius: 5px;
    border: 1px solid transparent; background: transparent; color: var(--ink-dim);
    font-size: 12.5px; font-family: inherit; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .atlas-editor-btn:hover { background: var(--surface-2); color: var(--ink); border-color: var(--line); }
  .atlas-editor-sep { width: 1px; height: 18px; background: var(--line); margin: 0 4px; flex-shrink: 0; }
  .atlas-editor-area {
    min-height: 220px;
    padding: 18px 20px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink);
    outline: none;
  }
  .atlas-editor-area:empty::before {
    content: attr(data-placeholder); color: var(--ink-faint); pointer-events: none;
  }

  .atlas-editor-area h1, .atlas-editor-readonly h1 { font-size: 25px; font-weight: 800; margin: 22px 0 12px; letter-spacing: -0.01em; }
  .atlas-editor-area h2, .atlas-editor-readonly h2 { font-size: 20px; font-weight: 700; margin: 20px 0 10px; letter-spacing: -0.01em; }
  .atlas-editor-area h3, .atlas-editor-readonly h3 { font-size: 17px; font-weight: 700; margin: 16px 0 8px; }
  .atlas-editor-area h1:first-child, .atlas-editor-area h2:first-child, .atlas-editor-area h3:first-child,
  .atlas-editor-readonly h1:first-child, .atlas-editor-readonly h2:first-child, .atlas-editor-readonly h3:first-child { margin-top: 0; }
  .atlas-editor-area p, .atlas-editor-readonly p { margin: 0 0 14px; }
  .atlas-editor-area ul, .atlas-editor-area ol,
  .atlas-editor-readonly ul, .atlas-editor-readonly ol { margin: 0 0 14px; padding-left: 24px; }
  .atlas-editor-area li, .atlas-editor-readonly li { margin-bottom: 6px; }
  .atlas-editor-area blockquote, .atlas-editor-readonly blockquote {
    border-left: 3px solid var(--blue-dim); padding: 6px 16px; margin: 14px 0;
    color: var(--ink-dim); font-style: italic; background: rgba(255,255,255,0.02);
  }
  .atlas-editor-area hr, .atlas-editor-readonly hr { border: none; border-top: 1px solid var(--line); margin: 20px 0; }
  .atlas-editor-area a, .atlas-editor-readonly a { color: var(--blue-bright); text-decoration: underline; }
  .atlas-editor-area img, .atlas-editor-readonly img {
    max-width: 100%; border-radius: 8px; margin: 14px 0; display: block; border: 1px solid var(--line);
  }
  .atlas-editor-readonly { font-size: 15.5px; line-height: 1.8; color: var(--ink); }
  .atlas-editor-empty { color: var(--ink-faint); font-style: italic; }

  /* ============ RESPONSIVO — celular como app ============ */
  @media (max-width: 720px) {
    .app { grid-template-columns: 1fr; grid-template-areas: "header" "main"; }
    .sidebar {
      position: fixed; top: 60px; left: 0; bottom: 0; width: 220px;
      transform: translateX(-100%); z-index: 50; transition: transform 0.18s ease;
    }
    .sidebar.open { transform: translateX(0); }
    .menu-btn { display: flex; }
    .search-wrap { display: none; }
    main { padding: 18px 16px 60px; }
    .view-title { font-size: 24px; }
    .form-actions { flex-direction: column-reverse; align-items: stretch; }
    .form-actions-left { justify-content: stretch; }
    .form-actions-left .btn-secondary,
    .form-actions-left .btn-danger-ghost { flex: 1; }
  }

</style>
